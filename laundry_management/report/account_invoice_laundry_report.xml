<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ================================================================
        GST RULE (UPDATED):
          GST is now calculated on the taxable base = Item Lines Total
          + Other Charges - Discount (not on item lines alone).

          GST = 18% x (rounded_manual_sum + rounded_other_charges - rounded_discount)
          Grand Total = taxable_base + GST

        LAYOUT NOTE: The "Overall" (items subtotal) figure is now shown
        as a totals row directly under the Items & Services table (bold,
        with a top border), alongside the summed Qty and summed Weight
        for that order — instead of being the first line inside the GST
        Summary box. The GST Summary box now starts with "Other
        Charges".

        If the rendered PDF doesn't reflect this after deploying:
          1. grep -r "report_invoice_laundry_bill" across every addon
             folder — a duplicate <template id="report_invoice_laundry_bill">
             elsewhere will silently override this one on load order.
          2. Check Settings > Technical > Views (dev mode) for any view
             with inherit_id pointing at this template that patches
             t-set="rounded_gst" via xpath.
          3. After confirming only one copy exists, upgrade the module
             so Odoo recompiles the cached QWeb view:
               ./odoo-bin -u <your_module_name> -d <your_database>
        ================================================================
    -->

    <template id="report_invoice_laundry_bill">

        <t t-call="web.html_container">

            <style>
                @page {
                    size: 80mm auto;
                    margin: 0 !important;
                }

                html, body {
                    margin: 0 !important;
                    padding: 0 !important;
                    font-family: Arial, sans-serif !important;
                }

                * {
                    font-family: Arial, sans-serif !important;
                }
            </style>

            <t t-foreach="docs" t-as="o">

                <div style="width:100%;
                            font-size:11px;
                            line-height:1.4;
                            position:relative;">

                    <table style="width:100%;
                                  margin-bottom:0px;
                                  border-collapse:collapse;">

                        <tr>

                            <td style="width:30%;
                                       text-align:left;
                                       vertical-align:top;
                                       padding-top:0;
                                       padding-bottom:0;">

                                <t t-if="o.company_id.logo">

                                    <img t-att-src="image_data_uri(o.company_id.logo)"
                                         style="height:120px;
                                                width:auto;
                                                display:block;
                                                margin:0;"/>

                                </t>

                            </td>

                            <td style="width:70%;
                                       text-align:left;
                                       vertical-align:top;
                                       padding-left:10mm;
                                       padding-bottom:0;">

                                <div style="margin-top:5px;">

                                    <div style="font-size:13px;
                                                font-weight:bold;
                                                line-height:1.2;
                                                padding-bottom:8px;">

                                        <t t-esc="o.company_id.name"/>

                                    </div>

                                    <div style="font-size:9px;
                                                line-height:1.4;">

                                        <t t-esc="o.company_id.street or ''"/><br/>
                                        <t t-esc="o.company_id.street2 or ''"/><br/>

                                        <t t-esc="o.company_id.city or ''"/>

                                        <t t-if="o.company_id.zip">
                                            -
                                            <t t-esc="o.company_id.zip"/>
                                        </t>

                                        <br/>

                                    </div>

                                    <div style="font-size:10px;">
                                        Ph:
                                        <t t-esc="o.company_id.phone or '-'"/>
                                    </div>

                                    <div style="font-size:10px;">
                                        GSTIN:
                                        <t t-esc="o.company_id.vat or '-'"/>
                                    </div>

                                </div>

                            </td>

                        </tr>

                    </table>

                    <div style="width:100%;
                                text-align:center;
                                margin-top:-10px;
                                margin-bottom:4px;
                                padding:0;">

                        <strong style="font-size:12px;
                                       text-transform:uppercase;
                                       letter-spacing:0.5px;">

                            TAX INVOICE

                        </strong>

                    </div>

                    <hr style="border:1px solid #666;
                               margin-top:0px;
                               margin-bottom:5px;"/>

                    <table style="width:100%;
                                  font-size:11px;
                                  margin-top:5px;">

                        <tr>

                            <td style="width:50%;
                                       vertical-align:top;
                                       font-size:9px;
                                       line-height:1.4;">

                                <b>Customer Name:</b>
                                <t t-esc="o.partner_id.name"/>
                                <br/>

                                <b>Address:</b>

                                <t t-esc="o.partner_id.street or ''"/>
                                <t t-esc="o.partner_id.street2 or ''"/>

                                <br/>

                                <t t-esc="o.partner_id.city or ''"/>

                                <t t-if="o.partner_id.zip">
                                    -
                                    <t t-esc="o.partner_id.zip"/>
                                </t>

                                <br/>

                                <b>Contact No:</b>
                                <t t-esc="o.partner_id.phone or '-'"/>

                            </td>

                            <td style="width:50%;
                                       text-align:left;
                                       vertical-align:top;
                                       font-size:9px;
                                       line-height:1.4;
                                       padding-left:16px;">

                                <b>Order No:</b>
                                <t t-esc="o.name"/>
                                <br/>

                                <b>Received Date:</b>

                                <span t-field="o.laundry_order_id.order_date"
                                      t-options="{'format': 'dd-MM-yyyy'}"/>

                                <br/>

                                <b>Delivery Date:</b>

                                <span t-field="o.laundry_order_id.delivery_date"
                                      t-options="{'format': 'dd-MM-yyyy'}"/>

                            </td>

                        </tr>

                    </table>

                    <hr style="border:1px solid #666;
                               margin-top:8px;"/>

                    <table style="width:100%;
                                  border-collapse:collapse;
                                  font-size:11px;">

                        <thead>

                            <tr>

                                <th style="text-align:left;
                                           font-weight:bold;
                                           padding:3px;
                                           vertical-align:top;
                                           line-height:1.2;">

                                    S.No.

                                </th>

                                <th style="text-align:left;
                                           font-weight:bold;
                                           padding:3px;
                                           vertical-align:top;
                                           line-height:1.2;">

                                    Items &amp; Services

                                </th>

                                <th style="text-align:right;
                                           font-weight:bold;
                                           padding:3px;
                                           vertical-align:top;
                                           line-height:1.2;">

                                    Qty

                                </th>

                                <th style="text-align:right;
                                           font-weight:bold;
                                           padding:3px;
                                           vertical-align:top;
                                           line-height:1.2;">

                                    Wt

                                    <div style="font-size:9px;
                                                color:#333;">

                                        (Kg)

                                    </div>

                                </th>

                                <th style="text-align:right;
                                           font-weight:bold;
                                           padding:3px;
                                           vertical-align:top;
                                           line-height:1.2;">

                                    Unit Price

                                    <div style="font-size:9px;
                                                color:#333;">

                                        (Rs.)

                                    </div>

                                </th>

                                <th style="text-align:right;
                                           font-weight:bold;
                                           padding:3px;
                                           vertical-align:top;
                                           line-height:1.2;">

                                    Amt

                                    <div style="font-size:9px;
                                                color:#333;">

                                        (Rs.)

                                    </div>

                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            <t t-set="i" t-value="0"/>
                            <t t-set="manual_sum_total" t-value="0"/>
                            <t t-set="qty_total" t-value="0"/>
                            <t t-set="weight_total" t-value="0"/>

                            <tr t-foreach="o.laundry_order_id.order_line_ids"
                                t-as="l">

                                <t t-set="i" t-value="i + 1"/>

                                <td style="padding:3px;
                                           text-align:left;
                                           border-bottom:1px solid #ddd;">

                                    <t t-esc="i"/>

                                </td>

                                <td style="padding:3px;
                                           border-bottom:1px solid #ddd;">

                                    <div>
                                        <t t-esc="l.product_id.name"/>
                                    </div>

                                    <div style="font-size:9px;
                                                color:#333;">

                                        <t t-esc="l.service_type_id.name"/>

                                        <t t-if="l.premium_id">

                                            <span> | </span>

                                            <t t-esc="l.premium_id.name"/>

                                        </t>

                                    </div>

                                </td>

                                <td style="padding:5px;
                                           text-align:right;
                                           border-bottom:1px solid #ddd;">

                                    <t t-set="qty_total" t-value="qty_total + l.qty"/>
                                    <t t-esc="l.qty"/>

                                </td>

                                <td style="padding:5px;
                                           text-align:right;
                                           border-bottom:1px solid #ddd;">

                                    <t t-set="weight_total" t-value="weight_total + (l.weight or 0.0)"/>
                                    <t t-esc="'%.2f' % (l.weight or 0.0)"/>

                                </td>

                                <td style="padding:3px;
                                           text-align:right;
                                           border-bottom:1px solid #ddd;">

                                    <!-- Unit Price: pre-tax base price as entered on the order line (matches backend unit_price field) -->
                                    <t t-esc="'%.2f' % round(l.unit_price, 0)"/>

                                </td>

                                <td style="padding:3px;
                                           text-align:right;
                                           border-bottom:1px solid #ddd;">

                                    <!-- Amt: pre-tax line subtotal, so Unit Price x Qty/Wt reconciles with this column. GST is shown separately in the summary below. -->
                                    <t t-set="line_subtotal"
                                       t-value="round(l.subtotal, 2) if l.subtotal else 0.0"/>

                                    <t t-set="manual_sum_total"
                                       t-value="manual_sum_total + line_subtotal"/>


                                    <t t-esc="'%.2f' % round(line_subtotal, 0)"/>

                                </td>

                            </tr>

                            <!-- OVERALL totals row: directly under Items table, with a bold line above.
                                 Shows summed Qty, summed Weight, and the Overall Amount together. -->
                            <tr>

                                <td colspan="2"
                                    style="padding:3px;
                                           text-align:right;
                                           border-top:1.5px solid #ddd;">

                                    Overall

                                </td>

                                <td style="padding:5px;
                                           text-align:right;
                                           border-top:1.5px solid #ddd;">

                                    <t t-esc="qty_total"/>

                                </td>

                                <td style="padding:5px;
                                           text-align:right;
                                           border-top:1.5px solid #ddd;">

                                    <t t-esc="'%.2f' % weight_total"/>

                                </td>

                                <td style="padding:5px;
                                           border-top:1.5px solid #ddd;">
                                </td>

                                <td style="padding:5px;
                                           text-align:right;
                                           border-top:1.5px solid #ddd;">

                                    <t t-esc="'%.2f' % round(manual_sum_total, 0)"/>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                    <hr style="border:1px solid #666;
                               margin-top:8px;"/>

                    <t t-set="discount_total"
                       t-value="sum(o.laundry_order_id.extra_line_ids.filtered(lambda l: l.product_id.product_type == 'discount').mapped('subtotal'))"/>

                    <t t-set="other_charges_total"
                       t-value="sum(o.laundry_order_id.extra_line_ids.filtered(lambda l: l.product_id.product_type == 'charge').mapped('subtotal'))"/>

                    <t t-set="rounded_manual_sum"
                       t-value="round(manual_sum_total, 0)"/>

                    <t t-set="rounded_discount"
                       t-value="round(abs(discount_total), 0)"/>

                    <t t-set="rounded_other_charges"
                       t-value="round(other_charges_total, 0)"/>

                    <!--
                        UPDATED: taxable base now includes Other Charges and
                        is net of Discount, i.e.:
                        taxable_base = Items + Other Charges - Discount
                        GST = 18% x taxable_base
                    -->
                    <t t-set="taxable_base"
                       t-value="rounded_manual_sum + rounded_other_charges - rounded_discount"/>

                    <t t-set="rounded_gst"
                       t-value="round(taxable_base * 0.18, 0)"/>

                    <t t-set="final_total"
                       t-value="round(taxable_base + rounded_gst, 0)"/>

                    <table style="width:100%;
                                  font-size:11px;
                                  margin-top:10px;">

                        <tr>

                            <td style="width:55%;
                                       vertical-align:top;">

                                <div style="font-weight:bold;
                                            font-size:12px;
                                            margin-bottom:5px;">

                                    GST Summary

                                </div>

                                <div>

                                    CGST + SGST:

                                    <t t-esc="'%.2f' % rounded_gst"/>

                                </div>

                            </td>

                            <td style="width:45%;
                                       vertical-align:top;">

                                <table style="width:100%;
                                              border-collapse:collapse;
                                              font-size:11px;">

                                    <tr>

                                        <td style="text-align:right;
                                                   padding:1px 0;
                                                   white-space:nowrap;">

                                               Other Charges

                                        </td>

                                        <td style="width:10px;
                                                   text-align:center;
                                                   padding:0 2px;">

                                            :

                                        </td>

                                        <td style="text-align:right;
                                                   padding:0;">

                                            
                                                <t t-esc="'%.2f' % rounded_other_charges"/>
                                            

                                        </td>

                                    </tr>
                                    <tr>

                                        <td style="text-align:right;
                                                   padding:1px 0;
                                                   white-space:nowrap;">

                                               Discount

                                        </td>

                                        <td style="width:10px;
                                                   text-align:center;
                                                   padding:0 2px;">

                                            :

                                        </td>

                                        <td style="text-align:right;
                                                   padding:0;">

                                            
                                                <t t-esc="'%.2f' % rounded_discount"/>
                                            

                                        </td>

                                    </tr>

                                    <tr>

                                        <td style="text-align:right;
                                                   padding:1px 0;
                                                   white-space:nowrap;">

                                               Subtotal

                                        </td>

                                        <td style="width:10px;
                                                   text-align:center;
                                                   padding:0 2px;">

                                            :

                                        </td>

                                        <td style="text-align:right;
                                                   padding:0;">

                                            
                                                <t t-esc="'%.2f' % taxable_base"/>
                                            

                                        </td>

                                    </tr>

                                    <tr>

                                        <td style="text-align:right;
                                                   padding:1px 0;
                                                   white-space:nowrap;">

                                               GST

                                        </td>

                                        <td style="width:10px;
                                                   text-align:center;
                                                   padding:0 2px;">

                                            :

                                        </td>

                                        <td style="text-align:right;
                                                   padding:0;">

                                            
                                                <t t-esc="'%.2f' % rounded_gst"/>
                                            

                                        </td>

                                    </tr>

                                    <tr>

                                        <td style="text-align:right;
                                                   padding-top:3px;
                                                   white-space:nowrap;">

                                            <b>Grand Total</b>

                                        </td>

                                        <td style="width:10px;
                                                   text-align:center;
                                                   padding-top:3px;">

                                            :

                                        </td>

                                        <td style="text-align:right;
                                                   padding-top:3px;
                                                   white-space:nowrap;">

                                            <b>
                                                <t t-esc="'%.2f' % final_total"/>
                                            </b>

                                        </td>

                                    </tr>

                                </table>

                            </td>

                        </tr>

                    </table>

                    <div style="margin-top:8px;
                                font-size:9px;
                                line-height:1.4;
                                word-wrap:break-word;
                                white-space:normal;">

                        <b>Amount Payable in Words:</b>

                        <t t-esc="o.currency_id.amount_to_text(final_total).replace('And Zero Paise', '').replace(' and Zero Paise', '')"/>

                        Only

                    </div>

                    <hr style="border:1px solid #666;
                               margin-top:8px;"/>

                    <table style="width:100%;
                                  margin-top:10px;
                                  font-size:10px;
                                  border-collapse:collapse;">

                        <tr>

                            <td style="width:65%;
                                       vertical-align:top;
                                       padding-right:8px;
                                       line-height:1.6;">

                                <div style="font-weight:bold;
                                            margin-bottom:4px;
                                            font-size:11px;">

                                    Payment Details

                                </div>

                                <div>
                                    <b>Bank:</b> HDFC Bank
                                </div>

                                <div>
                                    <b>Account No:</b> 50200119008704
                                </div>

                                <div>
                                    <b>IFSC:</b> HDFC0004033
                                </div>

                                <div>
                                    <b>Recipient:</b> VESTIDO FABWASH STUDIO
                                </div>

                            </td>

                            <td style="width:35%;
                                       vertical-align:top;
                                       text-align:center;">

                                <t t-set="upi_attachment"
                                   t-value="o.env['ir.attachment'].sudo().search([('name', '=', 'upi_qr.png')], limit=1)"/>

                                <t t-if="upi_attachment">
                                    <img t-att-src="'data:image/png;base64,' + o.generate_payment_qr()" 
                                         style="width:100px; height:100px;"/>
                                    <div style="font-size: 8px; margin-top: 2px;">Scan to Pay</div>

                                </t>

                                <t t-else="">

                                    <div style="font-size:8px;
                                                color:red;
                                                border:1px solid red;
                                                padding:5px;">

                                        QR Attachment Missing
                                        <br/>
                                        (Upload 'upi_qr.png')

                                    </div>

                                </t>

                            </td>

                        </tr>

                    </table>

                    <hr style="border:1px solid #666;
                               margin-top:8px;"/>

                </div>

                <div style="margin-top:8px;
                            font-size:9px;
                            line-height:1.4;
                            padding:4px;">

                    <b>Remarks:</b>

                    <div style="word-wrap:break-word;
                                white-space:normal;">

                        <t t-if="o.laundry_order_id.remarks">

                            <t t-esc="o.laundry_order_id.remarks"/>

                        </t>

                        <t t-else="">
                            -
                        </t>

                    </div>

                </div>

                <hr style="border:1px solid #666;
                           margin-top:8px;"/>

                <div style="margin-top:4px;
                            text-align:center;
                            font-style:normal;
                            font-weight:normal;
                            font-size:10px;">

                    Thank you for your patronage!

                </div>

            </t>

        </t>

    </template>

</odoo>