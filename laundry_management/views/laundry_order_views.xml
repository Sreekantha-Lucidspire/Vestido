<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_laundry_order_list" model="ir.ui.view">
        <field name="name">laundry.order.list</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="delivery_date"/>
                <field name="total_weight"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_laundry_order_form" model="ir.ui.view">
        <field name="name">laundry.order.form</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <form string="Laundry Order">
                <header>
                    <button name="action_received"
                            string="Receive"
                            type="object"
                            invisible="state != 'draft'"
                            class="btn-primary"/>

                    <button name="action_send_received_whatsapp" 
                            string="Notify Received" 
                            type="object" 
                            class="btn-success" 
                            icon="fa-whatsapp"
                            invisible="1"/>

                    <button name="action_washing"
                            string="Start Washing"
                            type="object"
                            invisible="1"/>

                    <button name="action_ironing"
                            string="Start Ironing"
                            type="object"
                            invisible="1"/>

                    <button name="action_ready"
                            string="Ready to Deliver"
                            type="object"
                            invisible="1"/>

                    <button name="action_delivered"
                            string="Deliver"
                            type="object"
                            invisible="1"
                            class="btn-success"/>

                    <button name="action_send_delivered_whatsapp"
                            string="Notify Delivered"
                            type="object"
                            class="btn-success"
                            icon="fa-whatsapp"
                            invisible="1"/>

                    <button name="action_generate_tags"
                            string="Generate Tags"
                            type="object"
                            class="btn-secondary" 
                            invisible="tag_ids"/>

                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-primary"
                            invisible="invoice_id or id == False"/>
                            
                    <button name="action_print_tags" string="Print Tags" type="object" class="btn-primary" invisible="not tag_ids"/>
                    <button name="action_print_receipt_80mm" string="Order Receipt" type="object" class="btn-primary" invisible="state == 'draft'"/>
                    
                    <button name="action_regenerate_tags"
                            string="Re-Generate Tags"
                            type="object"
                            class="btn-secondary" 
                            invisible="not tag_ids or state in ('ready','delivered')"/>

                    <button name="action_print_proforma_invoice"
                            string="Proforma Invoice"
                            type="object"
                            class="btn-info"/>

                    <button name="action_send_proforma_whatsapp"
                            string="Send on WhatsApp"
                            type="object"
                            class="btn-success"
                            icon="fa-whatsapp"
                            invisible="1"/>

                    <button name="action_print_invoice_bill" 
                            string="Tax Invoice" 
                            type="object" 
                            class="btn-primary" 
                            invisible="1"/>

                    <button name="action_tracker"
                            string="Operations Tracker"
                            type="object"
                            class="btn-info"
                            invisible="state not in ('received','washing','ironing','ready','delivered')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,received,ready,delivered" options="{'clickable': '1'}"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Invoice"/>
                        </button>

                        <button name="action_view_tags"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tags" 
                                invisible="not tag_ids">
                            <field name="tag_count" widget="statinfo" string="Tags"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..." 
                                   readonly="state not in ['draft']" 
                                   options="{'no_open': True, 'no_edit':True, 'no_create': True}"/>
                        </group>

                        <group>
                            <field name="order_date"/>
                            <field name="delivery_date"/>
                            <field name="has_wash" invisible="1"/>
                            <field name="has_iron" invisible="1"/>
                            <field name="tag_type"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <div class="mb8">
                        <div class="d-flex gap-3">
                            <div class="d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-baseline w-md-50">
                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                    <field name="email" class="w-100" widget="email" placeholder="Email"/>
                                </div>
                                <div class="d-flex align-items-baseline w-md-50">
                                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                    <field name="phone" class="w-100" widget="phone" placeholder="Phone"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Items">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="premium_id"/>
                                    <field name="product_id" />
                                    <field name="service_type_id"/>
                                    <field name="pricing_type"/>
                                    <field name="qty" sum="Total Qty"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="premium_multiplier" column_invisible="1"/>
                                    <field name="weight" sum="Total Weight" optional="show"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags" column_invisible="1"/>
                                    <field name="price_tax" widget="monetary" optional="show"/>
                                    <field name="price_total" widget="monetary" sum="Grand Total" optional="show"/>
                                </list>
                            </field>
                            
                            <div class="o_form_label mt-4 mb-2" style="font-weight: bold;">
                                Extra Charges
                            </div>
                            
                            <field name="extra_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="is_discount_line" column_invisible="1"/>
                                    <field name="discount_mode"
                                           string="Discount Type"
                                           invisible="not is_discount_line"/>
                                    <field name="discount_percent"
                                           string="Discount %"
                                           invisible="not is_discount_line or discount_mode != 'percent'"/>
                                    <!--
                                        FIX: added force_save="1".
                                        This field is conditionally readonly
                                        (readonly when discount_mode == 'percent'),
                                        and its value in that mode is set purely
                                        by the _onchange_discount_percent() onchange
                                        on the model, not typed in by the user.
                                        Without force_save="1", the Odoo web client
                                        excludes readonly fields from the values it
                                        sends to write() on Save, so the onchange
                                        value shown on screen was silently discarded
                                        and the record was saved with its old/zero
                                        price_unit instead. force_save="1" tells the
                                        client to include the current in-memory value
                                        of this field when saving, even though it's
                                        readonly, which fixes the "correct before
                                        save, wrong after save" bug.
                                    -->
                                    <field name="price_unit"
                                           string="Unit Price"
                                           widget="monetary"
                                           readonly="is_discount_line and discount_mode == 'percent'"
                                           force_save="1"/>
                                    <field name="tax_ids" widget="many2many_tags" column_invisible="1"/>
                                    <field name="subtotal" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Operations Tracker">
                            <field name="tracker_ids" readonly="1">
                               <list create="0" delete="0" edit="0">
                                   <field name="sequence" string="#"/>
                                   <field name="stage" string="Stage"/>
                                   <field name="stage_datetime" string="Date &amp; Time"/>
                                   <field name="wa_sent" string="WhatsApp Required" widget="boolean_toggle"/>
                                   <field name="staff_id" string="Staff"/>
                                   <field name="remarks" string="Remarks"/>
                               </list>
                            </field>
                        </page>
                    </notebook>

                    <!--
                        GST SUMMARY FOOTER
                        Order and labels match the printed invoice/report exactly:
                        Subtotal (no GST) -> GST -> Rounding Off -> Grand Total
                    -->
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_weight" readonly="1" invisible="1"/>
                        <field name="currency_id" invisible="1"/>

                        <field name="amount_untaxed" string="Subtotal" widget="monetary" readonly="1"/>
                        <field name="amount_tax" string="GST" widget="monetary" readonly="1"/>
                        <field name="rounding_off" string="Rounding Off" widget="monetary" readonly="1"/>

                        <field name="grand_total"
                               string="Grand Total"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="1"
                               class="oe_subtotal_footer_separator"/>
                    </group>
                    <div class="clearfix"/>

                    <group>
                        <field name="remarks" placeholder="Enter any remarks here..."/>
                    </group>

                    <group string="Uploaded Images">
                        <field name="document_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Image Name"/>
                                <field name="file" string="Image"
                                       filename="filename"
                                       widget="image"
                                       options="{'size': [120, 120]}"/>
                                <field name="filename" invisible="1"/>
                            </list>
                        </field>
                    </group>
                </sheet>

                <div class="oe_chatter" style="min-width: 330px; padding: 16px 24px;">
                    <div class="card p-3 shadow-sm border-0" style="background: #ffffff; border-radius: 8px; border-left: 4px solid #25D366; box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fa fa-whatsapp me-2 text-success" style="font-size: 20px;"/>
                            <h5 class="mb-0 text-dark" style="font-weight: 600; font-size: 15px;">WhatsApp Information</h5>
                        </div>
                        
                        <div class="mb-2">
                            <span class="text-muted d-block small fw-semibold">Status:</span>
                            <span class="text-success fw-bold d-flex align-items-center gap-1">
                                <i class="fa fa-check-circle"/> <field name="whatsapp_status" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        
                        <div class="mb-2">
                            <span class="text-muted d-block small fw-semibold">Sent Time:</span>
                            <span class="text-dark font-monospace small">
                                <field name="whatsapp_sent_datetime" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                        
                        <div>
                            <span class="text-muted d-block small fw-semibold">Sent By:</span>
                            <span class="text-secondary fw-semibold">
                                <field name="whatsapp_sent_by" readonly="1" nolabel="1"/>
                            </span>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="view_laundry_order_kanban" model="ir.ui.view">
        <field name="name">laundry.order.kanban</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="invoice_id"/>
                <field name="invoice_date"/>
                <field name="amount_total"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card p-2">
                            <div class="fw-bold small d-flex align-items-center flex-nowrap" style="gap: 4px;">
                                <strong class="text-nowrap">Order No:</strong>
                                <field name="name" class="text-nowrap"/>
                            </div>
                            <div>
                                <field name="partner_id"/>
                            </div>

                            <!--
                                "Order Received" label + date on one line:
                                widget="date"/"datetime" fields render as
                                block-level elements inside kanban templates
                                by default, so they drop to a new line no
                                matter what surrounds them. Forcing a flex
                                row here (instead of the plain <div> the
                                <strong> and <field> previously sat in)
                                keeps both pieces on the same line.

                                Color: switched from text-secondary (muted
                                gray) to text-dark so these lines match the
                                customer name's dark color instead of
                                looking greyed-out/disabled.
                            -->
                            <div class="text-dark small d-flex align-items-center flex-nowrap" style="gap: 4px;">
                                <strong class="text-nowrap">Order Received:</strong>
                                <field name="order_date" widget="date" class="text-nowrap"/>
                            </div>

                            <!--
                                Invoice No. line: shown only once the order
                                actually has a linked invoice (invoice_id
                                is set). Placed right after Order Received.
                            -->
                            <div class="text-dark small d-flex align-items-center flex-nowrap" style="gap: 4px;" invisible="not invoice_id">
                                <strong class="text-nowrap">Invoice No:</strong>
                                <field name="invoice_id" class="text-nowrap"/>
                            </div>

                            <div class="text-dark small d-flex align-items-center flex-nowrap" style="gap: 4px;" invisible="not invoice_id">
                                <strong class="text-nowrap">Invoice Date:</strong>
                                <field name="invoice_date" widget="date" class="text-nowrap"/>
                            </div>
                            <div>
                                <strong>₹ </strong>
                                <field name="amount_total"/>
                            </div>
                            <div class="mt-2">
                                <span class="badge bg-primary">
                                    <field name="state"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_laundry_order_search" model="ir.ui.view">
        <field name="name">laundry.order.search</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <search string="Search Laundry Orders">
                <field name="name" string="Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="invoice_id" string="Invoice"/>
                <field name="phone" string="Phone"/>
                <field name="email" string="Email"/>
                <field name="state"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Received" name="filter_received" domain="[('state','=','received')]"/>
                <filter string="Washing" name="filter_washing" domain="[('state','=','washing')]"/>
                <filter string="Ironing" name="filter_ironing" domain="[('state','=','ironing')]"/>
                <filter string="Ready" name="filter_ready" domain="[('state','=','ready')]"/>
                <filter string="Delivered" name="filter_delivered" domain="[('state','=','delivered')]"/>
                <filter string="Invoiced" name="filter_invoiced" domain="[('invoice_id','!=',False)]"/>
                <filter string="Not Invoiced" name="filter_not_invoiced" domain="[('invoice_id','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_laundry_order" model="ir.actions.act_window">
        <field name="name">Laundry Orders</field>
        <field name="res_model">laundry.order</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="search_view_id" ref="view_laundry_order_search"/>
    </record>
    <record id="view_laundry_order_tracker_list" model="ir.ui.view">
        <field name="name">laundry.order.tracker.list</field>
        <field name="model">laundry.order.tracker</field>
        <field name="arch" type="xml">
            <list string="Operations Tracker" create="0" delete="0" edit="0">
                <field name="sequence"/>
                <field name="stage"/>
                <field name="stage_datetime"/>
                <field name="wa_sent" widget="boolean_toggle"/>
                <field name="staff_id"/>
                <field name="remarks"/>
                <field name="completed" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_laundry_order_tracker" model="ir.actions.act_window">
        <field name="name">Operations Tracker</field>
        <field name="res_model">laundry.order.tracker</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_laundry_order_tracker_list"/>
    </record>
    <record id="view_laundry_order_calendar" model="ir.ui.view">
        <field name="name">laundry.order.calendar</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <calendar string="Delivery Schedule" 
                      date_start="delivery_date" 
                      mode="month"
                      event_open_popup="True">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="grand_total" widget="monetary"/>
            </calendar>
        </field>
    </record>   
    <record id="view_laundry_order_activity" model="ir.ui.view">
        <field name="name">laundry.order.activity</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <activity string="Laundry Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <strong class="o_activity_label">
                                <field name="name" display="full"/>
                            </strong>
                            <div class="text-muted">
                                <field name="partner_id" display="full"/>
                            </div>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record> 
</odoo>