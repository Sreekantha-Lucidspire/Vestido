<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot view: rows = Invoice, columns = Service Type, cell value = Amount -->
    <record id="view_account_move_line_service_pivot" model="ir.ui.view">
        <field name="name">account.move.line.service.pivot</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Service Type Report">
                <field name="move_id" type="row" string="Invoice"/>
                <field name="service_type_id" type="col" string="Service Type"/>
                <field name="price_subtotal" type="measure" string="Amount"/>
            </pivot>
        </field>
    </record>

    <!-- List fallback view (optional, lets users drill into raw lines) -->
    <record id="view_account_move_line_service_list" model="ir.ui.view">
        <field name="name">account.move.line.service.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Service Type Report" create="0" edit="0" delete="0">
                <field name="move_id" string="Invoice"/>
                <field name="partner_id" string="Customer"/>
                <field name="service_type_id" string="Service Type"/>
                <field name="price_subtotal" string="Amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_invoice_service_type_pivot" model="ir.actions.act_window">
        <field name="name">Service Type Report</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('move_id.move_type', '=', 'out_invoice'), ('service_type_id', '!=', False)]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_invoice_service_type_pivot_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_account_move_line_service_pivot"/>
        <field name="act_window_id" ref="action_invoice_service_type_pivot"/>
    </record>

    <record id="action_invoice_service_type_pivot_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_account_move_line_service_list"/>
        <field name="act_window_id" ref="action_invoice_service_type_pivot"/>
    </record>

    <!-- Menu item under Invoicing app -->
    <menuitem id="menu_invoice_service_type_pivot"
              name="Service Type Report"
              parent="account.menu_finance_reports"
              action="action_invoice_service_type_pivot"
              sequence="60"/>

</odoo>