<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_pickup_discount" model="ir.ui.view">
        <field name="name">account.move.form.inherit.pickup.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_invoice_whatsapp" 
                        string="Send via WhatsApp" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="state != 'posted' or is_whatsapp_sent == True"/>
                <button name="action_download_payment_qr" 
                        string="Download QR Code" 
                        type="object" 
                        class="btn-secondary"
                        invisible="1"/>
                <button name="action_open_pay_page" 
                        string="Payment Link" 
                        type="object" 
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="laundry_order_id" options="{'no_open': True, 'no_edit':True, 'no_create': True}"/>
                <field name="is_whatsapp_sent" readonly="1" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="extra_information" string="Extra Information">
                    <group string="Extra Information">
                        <field name="pickup_delivery"/>
                        <field name="invoice_discount"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="replace">
                <field name="premium_id" string="Premium Type"/>
                <field name="name" string="Items"/>
                <field name="service_type_id" string="Service Type"/>
                <field name="pricing_type" string="Pricing Type"/>
                <field name="quantity" string="Quantity"/>
                <field name="weight" string="Weight"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="tax_ids" widget="many2many_tags" string="Taxes" optional="hide"/>
                <field name="price_tax" string="Tax Price" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="column_invisible">False</attribute>
            </xpath>

            <!-- Hide the ORIGINAL quantity/price_unit columns still present
                 later in the row (inherited from account.view_move_form),
                 which duplicate the "Qty" / "Unit Price" fields added above -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity'][2]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit'][2]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="price_total" string="Total Price" optional="hide"/>
            </xpath>

            <!--
                GST SUMMARY (DISPLAY ONLY):
                The built-in "tax_totals" widget only ever reflects real
                tax records attached to invoice lines — it cannot be made
                to show a manually-calculated number. Since we're not
                attaching real taxes to lines, we hide that widget and
                replace it with plain fields (gst_amount, rounding_off,
                display_grand_total) computed in Python instead.

                IMPORTANT: These numbers are for display/printing only.
                "Amount Due" below (unaffected by this change) still
                reflects the real accounting total, which will NOT match
                this Grand Total. Payments/reconciliation follow Amount
                Due, not the number shown here.

                NOTE ON LAYOUT: We deliberately do NOT use a <group> with
                the legacy "oe_subtotal_footer" class here. That class was
                built for the old table-based totals layout; in current
                Odoo, <group> renders via CSS Grid, and the legacy class
                doesn't apply correctly to it — the label text and the
                monetary value end up overlapping. Using plain flexbox
                divs below avoids that entirely.
            -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!--
                "Amount Due" (amount_residual) lives inside the SAME native
                oe_subtotal_footer group as tax_totals. Hiding tax_totals
                above does not hide that group, so amount_residual keeps
                rendering through the same broken CSS-grid layout and
                overlaps too. We hide the native field here and re-add it
                as a clean row inside our own flexbox block below.
            -->
            <xpath expr="//group[hasclass('oe_subtotal_footer')]//field[@name='amount_residual']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="after">
                <div class="oe_right"
                     style="width: fit-content; margin-left: auto; display: grid;
                            grid-template-columns: max-content max-content;
                            column-gap: 12px; row-gap: 2px;">
                    <span style="white-space: nowrap;">Subtotal</span>
                    <div style="white-space: nowrap; overflow: visible; text-align: right;">
                        <field name="amount_untaxed" widget="monetary" readonly="1" nolabel="1"/>
                    </div>

                    <span style="white-space: nowrap;">GST</span>
                    <div style="white-space: nowrap; overflow: visible; text-align: right;">
                        <field name="gst_amount" widget="monetary" readonly="1" nolabel="1"/>
                    </div>

                    <span style="white-space: nowrap;">Rounding Off</span>
                    <div style="white-space: nowrap; overflow: visible; text-align: right;">
                        <field name="rounding_off" widget="monetary" readonly="1" nolabel="1"/>
                    </div>

                    <span class="fw-bold" style="white-space: nowrap; border-top: 1px solid #ccc; padding-top: 4px;">Grand Total</span>
                    <div class="fw-bold" style="white-space: nowrap; overflow: visible; text-align: right; border-top: 1px solid #ccc; padding-top: 4px;">
                        <field name="display_grand_total" widget="monetary" readonly="1" nolabel="1"/>
                    </div>

                    <span style="white-space: nowrap;">Amount Due</span>
                    <div style="white-space: nowrap; overflow: visible; text-align: right;">
                        <field name="amount_residual" widget="monetary" readonly="1" nolabel="1"/>
                    </div>
                </div>
                <div class="clearfix"/>
            </xpath>
        </field>
    </record>
</odoo>