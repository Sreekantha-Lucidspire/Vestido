<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_out_invoice_tree_phone" model="ir.ui.view">
        <field name="name">account.move.list.phone</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="partner_phone" string="Phone" optional="show"/>
                <field name="service_types_display" string="Service Types" optional="hide"/>
                <field name="amount_wash_fold" widget="monetary" string="Wash &amp; Fold" optional="show"/>
                <field name="amount_steam_iron" widget="monetary" string="Steam Iron" optional="show"/>
                <field name="amount_wash_iron" widget="monetary" string="Wash &amp; Iron" optional="show"/>
                <field name="amount_dry_cleaning" widget="monetary" string="Dry Cleaning" optional="show"/>
                <field name="amount_add_ons" widget="monetary" string="Add-Ons" optional="show"/>
                <field name="amount_shoe_cleaning" widget="monetary" string="Shoe Cleaning" optional="show"/>
                <field name="amount_roll_pressing" widget="monetary" string="Roll Pressing" optional="show"/>
                <field name="extra_charges_amount" widget="monetary" string="Extra Charges" optional="show"/>
                <field name="discount_amount_display" widget="monetary" string="Discount" optional="show"/>
                <field name="cgst_amount" widget="monetary" string="CGST 9%" optional="show"/>
                <field name="sgst_amount" widget="monetary" string="SGST 9%" optional="show"/>
                <field name="gst_amount" widget="monetary" string="GST 18%" optional="show"/>
                <field name="rounding_off" widget="monetary" string="Rounding Off" optional="show"/>
            </list>

            <field name="cgst_amount" position="before">
                <field name="amount_untaxed_in_currency_signed" position="move"/>
            </field>

            <field name="rounding_off" position="after">
                <field name="amount_total_in_currency_signed" position="move"/>
                <field name="display_grand_total" widget="monetary" string="Inv Amount" optional="show"/>
            </field>

            <field name="amount_total_in_currency_signed" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>

            <field name="amount_untaxed_in_currency_signed" position="attributes">
                <attribute name="string">Gross Sales</attribute>
            </field>
        </field>
    </record>
</odoo>